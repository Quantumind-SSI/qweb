{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "routes": [
    {
      "route": "/api/enquiry",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/chat",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/fbc",
      "redirect": "/bifrost",
      "statusCode": 301
    },
    {
      "route": "/fbc.html",
      "redirect": "/bifrost",
      "statusCode": 301
    },
    {
      "route": "/js/config.template.js",
      "statusCode": 404
    },
    {
      "route": "/img-orig/*",
      "statusCode": 404
    },
    {
      "route": "/js/config.js",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "public, max-age=600, must-revalidate"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "public, max-age=600, must-revalidate"
      }
    },
    {
      "route": "/*.{png,jpg,jpeg,webp,avif,svg,ico,woff2}",
      "headers": {
        "Cache-Control": "public, max-age=2592000"
      }
    },
    {
      "route": "/*",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src 'none'; worker-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".avif": "image/avif",
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
